{
  "expo": {
    "name": "Mercapty",
    "slug": "mercapty",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mercapty",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "com.mercapty.app"
    },
    "android": {
      "package": "com.mercapty.app",
      "adaptiveIcon": {
        "backgroundColor": "#1d4ed8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "ios": {
            "image": "./assets/images/splash-icon-ios.png",
            "imageWidth": 240
          }
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Mercapty usa la cámara para leer el código de barras de los productos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1d4ed8"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9612254533723437~6272777146",
          "iosAppId": "ca-app-pub-9612254533723437~2197800767"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a043a3b6-7eac-4f7a-8018-518dc0fcf602"
      },
      "admob": {
        "android": {
          "banner": "ca-app-pub-9612254533723437/2305611972",
          "interstitial": "ca-app-pub-9612254533723437/3210307569"
        },
        "ios": {
          "banner": "ca-app-pub-9612254533723437/9560093492",
          "interstitial": "ca-app-pub-9612254533723437/5670141912"
        }
      }
    },
    "runtimeVersion": "1.3.0",
    "updates": {
      "url": "https://u.expo.dev/a043a3b6-7eac-4f7a-8018-518dc0fcf602"
    }
  }
}
