{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "includeFiles": "public/index.html" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/go/:id", "destination": "/api" },
    { "source": "/ads.txt", "destination": "/api" },
    { "source": "/robots.txt", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/producto/:path*", "destination": "/api" },
    { "source": "/(buscar|tiendas|app|lista|admin)", "destination": "/api" }
  ]
}
